{
  "manifest_version": 3,
  "name": "Orbital Relay",
  "version": "1.0.0",
  "description": "A pixel-art power-grid puzzle that appears when the network goes dark.",
  "minimum_chrome_version": "106",
  "permissions": ["webNavigation"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Play Orbital Relay",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}

